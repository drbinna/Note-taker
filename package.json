{
  "name": "meet-notetaker",
  "version": "1.0.0",
  "description": "Self-hosted Google Meet notetaker bot",
  "scripts": {
    "login": "tsx scripts/login.ts",
    "join": "tsx src/cli.ts join",
    "process": "tsx src/cli.ts process",
    "dev": "tsx src/server.ts",
    "build": "tsc && cp src/bot/audio-capture.js dist/src/bot/",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^18.0.8",
    "playwright": "^1.64.1",
    "undici": "^8.12.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "type": "module",
  "private": true
}
