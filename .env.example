# Name shown in the call when joining as a guest
BOT_NAME=Lantern Notetaker

# API keys
# Fireworks does both transcription and the notes
FIREWORKS_API_KEY=
# Summary model on Fireworks (full model ID). Default: DeepSeek V4.1 Flash
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4p1-flash
# Transcription: whisper-v3 (most accurate) or whisper-v3-turbo (faster, cheaper)
FIREWORKS_ASR_MODEL=whisper-v3

# Optional: post summaries to a Slack channel (Incoming Webhook URL)
SLACK_WEBHOOK_URL=

# Browser
PROFILE_DIR=.bot-profile
CHROME_CHANNEL=
HEADLESS=false

# Timing
ADMIT_TIMEOUT_MIN=10
ALONE_TIMEOUT_SEC=60
MAX_DURATION_MIN=180

# Team server (npm start)
PORT=8080
# Optional. Leave empty for an open dashboard; set it to require an access code.
SERVER_TOKEN=
OUTPUT_DIR=meetings
